{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@javarosa-js/utils": [
        "packages/utils/src"
      ],
      "@javarosa-js/xforms": [
        "packages/xforms/src"
      ],
      "@javarosa-js/xpath": [
        "packages/xpath/src"
      ],
      "@javarosa-js/core": [
        "packages/core/src"
      ]
    }
  }
}